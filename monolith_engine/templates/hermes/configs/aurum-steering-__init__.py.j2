def _timezone(name: str) -> ZoneInfo:
    try:
        return ZoneInfo(name)
    except ZoneInfoNotFoundError:
        return ZoneInfo("UTC")


def classify_task(user_message: str) -> str:
    text = (user_message or "").lower()
    rule_map = dict(TASK_RULES)
    for task_type in ("unsafe_or_regulated_request",):
        keywords = rule_map[task_type]
        if any(_contains_keyword(text, keyword) for keyword in keywords):
            return task_type
    for task_type, keywords in TASK_OVERRIDES:
        if any(_contains_keyword(text, keyword) for keyword in keywords):
            return task_type
    for task_type in TASK_PRIORITY:
        if task_type == "unsafe_or_regulated_request":
            continue
        keywords = rule_map[task_type]
        if any(_contains_keyword(text, keyword) for keyword in keywords):
            return task_type
    return "general_chief_of_staff"


def normalize_input(user_message: str) -> dict[str, object]:
    task_type = classify_task(user_message)
    return {
        "detected_intent": task_type,
        "action_gate": ACTION_GATES[task_type],
        "confidence": "low" if task_type == "general_chief_of_staff" else "medium",
        "missing_constraints": MISSING_CONSTRAINTS[task_type],
        "suggested_response_contract": RESPONSE_CONTRACTS[task_type],
        "advisory_only": True,
    }


def _contains_keyword(text: str, keyword: str) -> bool:
    escaped = re.escape(keyword.lower())
    if keyword[:1].isalnum() and keyword[-1:].isalnum():
        return re.search(rf"(?<![a-z0-9]){escaped}(?![a-z0-9])", text) is not None
    return keyword.lower() in text


def market_session(now: datetime) -> str:
    if now.weekday() >= 5:
        return "weekend"
    current = now.time()
    if wall_time(4, 0) <= current < wall_time(9, 30):
        return "premarket"
    if wall_time(9, 30) <= current < wall_time(16, 0):
        return "regular_hours"
    if wall_time(16, 0) <= current < wall_time(20, 0):
        return "after_hours"
    return "market_closed"


def _context_excerpt(filename: str) -> str:
    path = AURUM_CONTEXT_DIR / filename
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return ""

    lines = []
    capture = False
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        lowered = line.lower()
        if lowered.startswith("## context hook summary"):
            capture = True
            continue
        if capture and lowered.startswith("## "):
            break
        if capture:
            cleaned = " ".join(line.lstrip("-*0123456789. ").split())
            if cleaned:
                lines.append(cleaned)

    if not lines:
        lines = [" ".join(line.strip().split()) for line in text.splitlines() if line.strip() and not line.startswith("#")]

    excerpt = "; ".join(lines)
    return excerpt[:AURUM_CONTEXT_MAX_CHARS]


def _profile_context_lines(task_type: str) -> list[str]:
    if task_type not in CONTEXT_PROFILE_INTENTS:
        return []

    lines = [
        "decision_frame=strategy_adherence_not_trade_advice",
        "scorecard_dimensions=setup_alignment,catalyst_quality,entry_defined,invalidation_defined,risk_within_policy,timeframe_match,emotional_state_risk,data_freshness",
    ]
    skills = _context_excerpt("skills.md")
    if skills:
        lines.append(f"skills_md={skills}")
    trading_system = _context_excerpt("trading_system.md")
    if trading_system:
        lines.append(f"trading_system_md={trading_system}")
    return lines


def build_context(user_message: str, *, now: datetime | None = None) -> str:
    local_tz = _timezone(DEFAULT_TIMEZONE)
    local_now = (now or datetime.now(timezone.utc)).astimezone(local_tz)
    utc_now = local_now.astimezone(timezone.utc)
    normalized = normalize_input(user_message)
    task_type = str(normalized["detected_intent"])

    return "\n".join(
        (
            "BEGIN_AURUM_STEERING_CONTEXT",
            f"profile={PROFILE}",
            f"time_local={local_now.isoformat()} time_utc={utc_now.isoformat()} timezone={DEFAULT_TIMEZONE} weekday={local_now.strftime('%A')} market_session={market_session(local_now)} clock_only=true",
            f"intent={task_type} confidence={normalized['confidence']} advisory_only=true",
            "priority=raw_user_message_and_history guardrails=cannot_place_or_execute_orders,no_guaranteed_outcomes,no_trade_commands,separate_facts_risk_next_action",
            *_profile_context_lines(task_type),
            "END_AURUM_STEERING_CONTEXT",
        )
    )


def inject_aurum_steering(user_message: str = "", **kwargs):
    try:
        return {"context": build_context(user_message)}
    except Exception:
        LOGGER.exception("Aurum steering injection failed")
        return None


def register(ctx):
    ctx.register_hook("pre_llm_call", inject_aurum_steering)
