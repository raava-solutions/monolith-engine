# {{ agent_name | default('Agent') }} — legacy op-mode secret references (deprecated)
# Used by: op run --env-file=/etc/hermes/{{ agent_slug | default('agent') }}.env.tpl
# Vault: {{ vault_name | default('') }}

{% set provider_key = raw_api_key if raw_api_key is defined and raw_api_key else (openrouter_api_key if openrouter_api_key is defined and openrouter_api_key else '') %}

{% if provider_key %}
# Raw API key provided directly (not 1Password reference)
OPENROUTER_API_KEY={{ provider_key }}
{% elif secrets is defined and secrets %}
{% for secret in secrets %}
{% if secret.op_ref %}{{ secret.env_var }}={{ secret.op_ref }}
{% elif secret.value %}{{ secret.env_var }}={{ secret.value }}
{% endif %}
{% endfor %}
{% else %}
OPENROUTER_API_KEY=op://{{ vault_name | default('') }}/OpenRouter API/notesPlain
{% endif %}

{% if provider_key and secrets is defined and secrets %}
{% for secret in secrets %}
{% if secret.env_var != "OPENROUTER_API_KEY" %}
{% if secret.op_ref %}{{ secret.env_var }}={{ secret.op_ref }}
{% elif secret.value %}{{ secret.env_var }}={{ secret.value }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

{% if integration_secrets is defined %}
{% for key, ref in integration_secrets.items() %}
{{ key }}={{ ref }}
{% endfor %}
{% endif %}

{% if discord_channel is defined and discord_channel %}
DISCORD_HOME_CHANNEL={{ discord_channel }}
{% endif %}
