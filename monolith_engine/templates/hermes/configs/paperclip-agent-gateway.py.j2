def _cic_text_to_html(report_text):
    text = str(report_text or "").replace("#012", "\n").strip()
    if not text:
        return ""
    generated = ""
    title = "CIC Morning Report"
    rows = []
    alignments = []
    current_basket = ""

    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        heading = re.fullmatch(r"\*\*(.+?)\*\*(?:\s+[—-]\s+(.+))?", line)
        if heading:
            heading_text = heading.group(1).strip()
            if heading_text == "CIC":
                generated = (heading.group(2) or "").strip()
            elif heading_text == "Alignment":
                current_basket = "Alignment"
            else:
                current_basket = heading_text
            continue
        if current_basket == "Alignment":
            clean_line = re.sub(r"^[^\w]+", "", line).strip()
            if clean_line:
                alignments.append(clean_line)
            continue
        match = re.match(
            r"^[^\w]*(Daily|Weekly|Monthly|Quarterly)\s+"
            r"(BULL|BEAR)\s+\(([^)]+)\)\s+[—-]\s+"
            r"(.+?)\s+held\s+(.+?)\s+\|\s+(.+?)\s+took\s+(.+?)\s+→\s+(.+)$",
            line,
        )
        if match and current_basket:
            timeframe, direction, split, held, held_level, took, took_level, state = match.groups()
            rows.append(
                {
                    "basket": current_basket,
                    "timeframe": timeframe,
                    "direction": direction,
                    "split": split,
                    "held": held,
                    "heldLevel": held_level,
                    "took": took,
                    "tookLevel": took_level,
                    "state": state,
                }
            )

    date_label = datetime.now(UTC).strftime("%Y-%m-%d")
    generated_label = _html_escape(generated or datetime.now(UTC).strftime("%Y-%m-%d %H:%M UTC"))
    summary = "No CICs detected across the configured baskets."
    if rows:
        aligned_count = len(alignments)
        top = alignments[0] if alignments else f"{rows[0]['basket']} {rows[0]['direction']} {rows[0]['timeframe']}"
        summary = (
            f"{len(rows)} CIC signals detected across {len(set(row['basket'] for row in rows))} baskets. "
            f"{aligned_count} daily/weekly alignments flagged. Primary focus: {_html_escape(top)}."
        )

    row_html = []
    for row in rows:
        row_html.append(
            "<tr>"
            f"<td>{_html_escape(row['basket'])}</td>"
            f"<td>{_html_escape(row['timeframe'])}</td>"
            f"<td>{_html_escape(row['direction'])}</td>"
            f"<td>{_html_escape(row['split'])}</td>"
            f"<td>{_html_escape(row['held'])} held {_html_escape(row['heldLevel'])}</td>"
            f"<td>{_html_escape(row['took'])} took {_html_escape(row['tookLevel'])}</td>"
            f"<td>{_html_escape(row['state'])}</td>"
            "</tr>"
        )
    if not row_html:
        row_html.append('<tr><td colspan="7">No CICs detected across configured baskets.</td></tr>')

    alignment_items = "".join(f"<li>{_html_escape(item)}</li>" for item in alignments) or "<li>No daily/weekly alignments flagged.</li>"
    routine_contracts_sha = _sha256_file(ROUTINE_CONTRACTS_PATH)
    return (
        f'<section class="cic-morning-report" data-date="{_html_escape(date_label)}">'
        f"<h2>{_html_escape(title)} — {_html_escape(date_label)}</h2>"
        f'<p class="timestamp">Generated: {generated_label}</p>'
        '<div class="summary">'
        "<strong>Executive Summary</strong>"
        f"<p>{summary}</p>"
        "</div>"
        "<h3>Signal Table</h3>"
        "<table>"
        "<tr><th>Basket</th><th>Timeframe</th><th>Direction</th><th>Split</th><th>Held</th><th>Took</th><th>State</th></tr>"
        + "".join(row_html)
        + "</table>"
        '<div class="notice">'
        "<strong>Aligned Signals</strong>"
        f"<ul>{alignment_items}</ul>"
        "</div>"
        '<section class="data-sources">'
        "<h3>Data Sources</h3>"
        "<ul>"
        "<li>Script: /home/agent/scripts/cic_morning_report.py</li>"
        "<li>Runtime: /home/agent/hermes-agent/venv/bin/python</li>"
        "<li>Baskets: Equity ES/NQ/YM/RTY; Metals GC/SI/PL; Energy CL/HO/RB; FX 6E/6B.</li>"
        "<li>Provider: yfinance futures data at report runtime.</li>"
        "</ul>"
        "</section>"
        '<section class="provenance">'
        "<h3>Provenance</h3>"
        "<ul>"
        f"<li>Routine contracts: {_html_escape(ROUTINE_CONTRACTS_PATH)}</li>"
        f"<li>Routine contracts SHA256: <code>{_html_escape(routine_contracts_sha)}</code></li>"
        f"<li>Source-of-truth mirror: {_html_escape(SOURCE_OF_TRUTH_PATH)}</li>"
        f"<li>Source-of-truth present: {_html_escape(str(os.path.isdir(SOURCE_OF_TRUTH_PATH)))}</li>"
        "</ul>"
        "</section>"
        "</section>"
    )[:20000]


def _sha256_file(path):
    try:
        digest = hashlib.sha256()
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        return digest.hexdigest()
    except OSError:
        return ""


def _slug_text(value, fallback="scheduled-report"):
    slug = re.sub(r"[^a-z0-9]+", "-", str(value or "").lower()).strip("-")
    return slug[:80] or fallback


def _validate_report_contract_v1_body(body_text):
    try:
        payload = json.loads(str(body_text or ""))
    except json.JSONDecodeError as error:
        raise RuntimeError(f"report-contract-v1 body must be valid JSON: {error}") from error
    if not isinstance(payload, dict):
        raise RuntimeError("report-contract-v1 body must be a JSON object")
    required = (
        "contract_version",
        "report_id",
        "stream_id",
        "kind",
        "workspace",
        "generated_at",
        "period",
        "title",
        "agent",
        "blocks",
    )
    missing = [key for key in required if payload.get(key) in (None, "", [], {})]
    if missing:
        raise RuntimeError(f"report-contract-v1 missing required fields: {', '.join(missing)}")
    if str(payload.get("contract_version")) != "1":
        raise RuntimeError("report-contract-v1 contract_version must be 1")
    if not isinstance(payload.get("period"), dict):
        raise RuntimeError("report-contract-v1 period must be an object")
    if not isinstance(payload.get("agent"), dict) or not payload["agent"].get("id"):
        raise RuntimeError("report-contract-v1 agent.id is required")
    if not isinstance(payload.get("blocks"), list):
        raise RuntimeError("report-contract-v1 blocks must be an array")
    return payload


def _report_contract_v1_from_html(html_body, prompt, task_id):
    title = _report_failure_title(prompt)
    today = datetime.now(UTC).strftime("%Y-%m-%d")
    generated_at = datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")
    slug = _slug_text(title)
    agent_id = os.environ.get("PAPERCLIP_AGENT_ID") or "paperclip-agent-gateway"
    workspace = os.environ.get("MONOLITH_TENANT_ID") or os.environ.get("TENANT_ID") or "monolith"
    contract = {
        "contract_version": "1",
        "report_id": f"{slug}-{today}",
        "stream_id": slug,
        "kind": "routine-report",
        "workspace": workspace,
        "generated_at": generated_at,
        "period": {"type": "date", "date": today, "label": "Today"},
        "title": title,
        "subtitle": "Generated from the deterministic Paperclip report path.",
        "tags": ["client-ready"],
        "agent": {"id": agent_id, "instance": os.uname().nodename},
        "blocks": [
            {
                "type": "summary",
                "headline": title,
                "body": "Generated report artifact is available in the typed HTML block below.",
                "tone": "neutral",
            },
            {"type": "html", "html": _style_report_document(html_body)},
            {
                "type": "provenance",
                "data": {
                    "taskId": task_id,
                    "sourceDocuments": ["Paperclip issue context", ROUTINE_CONTRACTS_PATH],
                    "routineContractsSha256": _sha256_file(ROUTINE_CONTRACTS_PATH),
                },
            },
        ],
    }
    body = json.dumps(contract, separators=(",", ":"), sort_keys=True)
    _validate_report_contract_v1_body(body)
    return body


def _html_escape(value):
    return (
        str(value or "")
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
        .replace("'", "&#39;")
    )


def _declared_script_diagnostics(prompt):
    diagnostics = []
    for path in re.findall(r"(?:python3?|/home/agent/hermes-agent/venv/bin/python)\s+(/home/agent/scripts/[A-Za-z0-9_./-]+\.py)", str(prompt or "")):
        if not os.path.isfile(path):
            diagnostics.append(f"Declared script is missing on this runtime: {path}")
    return diagnostics


def _report_failure_title(prompt):
    text = str(prompt or "")
    for title in (
        "SCTR Morning Brief",
        "SCTR Intraday",
        "SCTR Evening Baseline",
        "CIC Morning Report",
        "Morning Prep",
        "Unified EOD Report",
        "Alpha Engine Daily Tracker",
        "Data Pipeline Health",
        "Routine Run Monitor",
        "Weekly Research Memo",
        "COT Weekly",
    ):
        if title in text:
            return title
    return "Scheduled Report"


def _report_document_key(prompt):
    if "Routine Run Monitor" in str(prompt or ""):
        return "routine-run-ledger"
    return "report"


def _payload_report_document_key(payload):
    context = payload.get("context") if isinstance(payload.get("context"), dict) else {}
    issue = context.get("paperclipIssue") if isinstance(context.get("paperclipIssue"), dict) else {}
    title = str(issue.get("title") or context.get("title") or "").strip()
    description = str(issue.get("description") or context.get("description") or "")
    if title == "Routine Run Monitor" or "Routine Run Monitor" in description:
        return "routine-run-ledger"
    return ""


def _payload_prefers_report_contract(payload):
    context = payload.get("context") if isinstance(payload.get("context"), dict) else {}
    issue = context.get("paperclipIssue") if isinstance(context.get("paperclipIssue"), dict) else {}
    text = "\n".join(
        str(part or "")
        for part in (
            issue.get("title"),
            issue.get("description"),
            context.get("paperclipTaskMarkdown"),
        )
        if part
    ).lower()
    return REPORT_CONTRACT_V1_KEY in text or "report contract v1" in text


def _payload_issue_prompt(payload):
    context = payload.get("context") if isinstance(payload.get("context"), dict) else {}
    issue = context.get("paperclipIssue") if isinstance(context.get("paperclipIssue"), dict) else {}
    return "\n".join(
        str(part or "")
        for part in (
            issue.get("title"),
            issue.get("description"),
            context.get("paperclipTaskMarkdown"),
        )
        if part
    )


def _direct_deterministic_report_body(payload):
    prompt = _payload_issue_prompt(payload)
    if not prompt:
        return ""
    for producer in (
        _routine_monitor_prompt_html_report,
        _unified_eod_prompt_html_report,
        _alpha_engine_prompt_html_report,
        _data_pipeline_prompt_html_report,
        _cic_prompt_html_report,
        _sctr_prompt_html_report,
    ):
        body = producer(prompt)
        if body:
            return body
    return ""


def _run_direct_deterministic_report(payload, task_id):
    body = _direct_deterministic_report_body(payload)
    if not body:
        return None
    publish_typed = _payload_prefers_report_contract(payload)
    key = REPORT_CONTRACT_V1_KEY if publish_typed else (_payload_report_document_key(payload) or "report")
    format_text = "markdown" if publish_typed else "html"
    document_body = _report_contract_v1_from_html(body, _payload_issue_prompt(payload), task_id) if publish_typed else body
    results = _execute_paperclip_tool_calls(
        [
            {
                "tool": "paperclip_put_task_document",
                "args": {
                    "issue_id": task_id,
                    "key": key,
                    "format": format_text,
                    "body": document_body,
                },
            },
        ],
        payload,
    )
    required_document_written = _has_report_contract_document_write(results) if publish_typed else _has_report_document_write(results)
    if required_document_written:
        results.extend(
            _execute_paperclip_tool_calls(
                [
                    {
                        "tool": "paperclip_update_task",
                        "args": {
                            "issue_id": task_id,
                            "status": "done",
                            "comment": f"Deterministic report published to Paperclip key={key}, format={format_text}.",
                        },
                    },
                ],
                payload,
            )
        )
    ok = required_document_written and _has_task_status_update(results)
    return {
        "exitCode": 0 if ok else 1,
        "stdout": f"Deterministic report path used; documentKey={key}; ok={ok}",
        "stderr": "" if ok else "Deterministic report tool call failed",
        "toolResults": results,
    }


def _report_failure_rows(completed, prompt):
    stdout = str(completed.stdout or "")
    stderr = str(completed.stderr or "")
    combined = f"{stdout}\n{stderr}"
    rows = []
    if completed.returncode is None or "timed out" in combined.lower():
        rows.append(("Runtime", "The report runtime timed out before producing a valid Paperclip report document."))
    if "DANGEROUS COMMAND" in combined:
        rows.append(("Command Policy", "The agent attempted a denied inline command instead of the declared routine tool path."))
    if "write() argument must be str, not dict" in combined:
        rows.append(("Tool Stream", "Hermes hit a tool-stream writer type error while the report run was active."))
    if "KeyboardInterrupt" in combined:
        rows.append(("Runtime", "The report process was interrupted before delivery completed."))
    if "Traceback" in combined and not any(label == "Tool Stream" for label, _ in rows):
        rows.append(("Runtime", "The report process raised an exception before a trustworthy report was delivered."))
    for diagnostic in _declared_script_diagnostics(prompt):
        rows.append(("Declared Data Tool", diagnostic))
    if not rows:
        rows.append(("Delivery", "The agent did not emit the required Paperclip document write for this report."))
    return rows


def _fallback_report_document(completed, task_id, prompt=None):
    raw_stdout = str(completed.stdout or "")
    task_attr = _html_escape(task_id)
    report_title = _html_escape(_report_failure_title(prompt))
    rows = _report_failure_rows(completed, prompt)
    row_html = "".join(
        "<tr>"
        f"<th>{_html_escape(label)}</th>"
        f"<td>{_html_escape(detail)}</td>"
        "</tr>"
        for label, detail in rows
    )
    if "DANGEROUS COMMAND" in raw_stdout:
        return (
            f'<section class="routine-delivery-status" data-task-id="{task_attr}">'
            f"<h2>{report_title} — Delivery Blocked</h2>"
            '<p class="timestamp">Generated by Paperclip gateway fallback</p>'
            '<div class="summary"><strong>Executive Summary</strong>'
            "<p>The routine reached the runtime command guard and did not produce the required report. "
            "This issue is blocked until the agent uses the declared report tool path.</p></div>"
            "<table>"
            f"{row_html}"
            "<tr><th>Report document</th><td>key=report, format=html</td></tr>"
            "<tr><th>Next run requirement</th><td>Use only the declared routine script/tool path; do not probe packages inline.</td></tr>"
            "</table>"
            '<section class="data-sources"><h3>Data Sources</h3><ul>'
            "<li>Paperclip issue context and gateway runtime diagnostics.</li>"
            "</ul></section>"
            "</section>"
        )[:20000]
    next_step = (
        "Install or repair the declared data tool, rerun the routine, and only mark done after a "
        "real HTML report is attached."
        if any(label == "Declared Data Tool" for label, _ in rows)
        else "Rerun the routine after fixing the runtime failure; do not mark done until the report document contains the actual report."
    )
    return (
        f'<section class="routine-delivery-status" data-task-id="{task_attr}">'
        f"<h2>{report_title} — Delivery Blocked</h2>"
        '<p class="timestamp">Generated by Paperclip gateway fallback</p>'
        '<div class="summary"><strong>Executive Summary</strong>'
        "<p>The scheduled report did not complete, so this document records a clean blocker "
        "instead of exposing raw terminal output as a report.</p></div>"
        "<h3>Blocking Evidence</h3>"
        f"<table>{row_html}</table>"
        '<section class="notice"><h3>Next Recovery Step</h3>'
        f"<p>{_html_escape(next_step)}</p></section>"
        '<section class="data-sources"><h3>Data Sources</h3><ul>'
        "<li>Paperclip issue context and gateway runtime diagnostics.</li>"
        "<li>Raw tracebacks and terminal logs are intentionally excluded from report documents.</li>"
        "</ul></section>"
        "</section>"
    )[:20000]


def _timeout_text(value):
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


def _ensure_report_document(tool_results, completed, payload, task_id, prompt):
    if not task_id or not _prompt_requires_report_document(prompt):
        return []
    requires_contract = _prompt_requires_report_contract(prompt)
    if requires_contract and _has_report_contract_document_write(tool_results):
        return []
    if not requires_contract and _has_report_document_write(tool_results):
        return []
    body = _extract_html_report_body(
        "\n".join(part for part in (completed.stdout or "", completed.stderr or "") if part)
    )
    used_fallback = False
    if not body:
        body = _read_latest_prompt_html_report(prompt)
    if not body:
        body = _cic_prompt_html_report(prompt)
    if not body:
        body = _sctr_prompt_html_report(prompt)
    if not body:
        body = _data_pipeline_prompt_html_report(prompt)
    if not body:
        body = _unified_eod_prompt_html_report(prompt)
    if not body:
        body = _alpha_engine_prompt_html_report(prompt)
    if not body:
        body = _routine_monitor_prompt_html_report(prompt)
    if not body:
        body = _fallback_report_document(completed, task_id, prompt)
        used_fallback = True
    document_key = REPORT_CONTRACT_V1_KEY if requires_contract and not used_fallback else _report_document_key(prompt)
    document_format = "markdown" if document_key == REPORT_CONTRACT_V1_KEY else "html"
    document_body = _report_contract_v1_from_html(body, prompt, task_id) if document_key == REPORT_CONTRACT_V1_KEY else _style_report_document(body)
    results = _execute_paperclip_tool_calls(
        [
            {
                "tool": "paperclip_put_task_document",
                "args": {
                    "issue_id": task_id,
                    "key": document_key,
                    "format": document_format,
                    "body": document_body,
                },
            }
        ],
        payload,
    )
    required_document_written = _has_report_contract_document_write(results) if document_key == REPORT_CONTRACT_V1_KEY else _has_report_document_write(results)
    if required_document_written and (used_fallback or not _has_task_status_update(tool_results)):
        status = "blocked" if used_fallback else "done"
        comment = (
            "HTML status document attached to Paperclip key=report, but the actual report was not produced. "
            "Task left blocked for rerun or investigation."
            if used_fallback
            else f"Report document attached to Paperclip key={document_key} with format={document_format}."
        )
        results.extend(
            _execute_paperclip_tool_calls(
                [
                    {
                        "tool": "paperclip_update_task",
                        "args": {
                            "issue_id": task_id,
                            "status": status,
                            "comment": comment,
                        },
                    }
                ],
                payload,
            )
        )
    return results


def _retry_missing_tool_calls(completed, payload, task_id, run_id, agent_id, company_id, wake_reason, original_prompt):
    if not task_id:
        return [], "", ""
    if _extract_tool_calls(completed.stdout or ""):
        return [], "", ""

    retry_prompt = (
        "Your previous Paperclip response did not include any executable tool call, "
        "so no Paperclip write happened. This is a correction pass. "
        f"Emit only one or more lines beginning with {TOOL_CALL_PREFIX} followed by JSON. "
        "Do not explain. Do not acknowledge. Do not use markdown. "
        "Do not emit read-only tools in this correction pass. "
        "If the task asks for a report, document, HTML output, or mandatory Paperclip "
        "document delivery, emit paperclip_put_task_document with issue_id=taskId, "
        "key set to the declared Paperclip document key when the task names one, otherwise key=report, "
        "format=markdown and a raw Report Contract v1 JSON body when the declared key is report-contract-v1; "
        "otherwise format=html and an HTML body. "
        "If prior stdout shows a blocker or denied command, the HTML body must be a "
        "blocker/status report with the failed command and next fix. "
        "If the task asks for a comment, emit paperclip_comment_on_task. "
        "If the task asks to mark done, also emit paperclip_update_task with status done. "
        "If the task asks to delegate, emit paperclip_delegate_to_report. "
        f"Allowed tools: {_allowed_tools_text()}. "
        f"runId={run_id}; agentId={agent_id}; companyId={company_id}; "
        f"taskId={task_id}; wakeReason={wake_reason}; "
        f"assignmentContext={original_prompt[-6000:]}; "
        f"previousStdout={(completed.stdout or '')[-2000:]}"
    )
    try:
        retry = _run_hermes_prompt(
            retry_prompt,
            payload,
            max(30, min(HERMES_TIMEOUT_SEC, 90)),
        )
    except Exception as error:
        return [], "", str(error)
    return _execute_paperclip_tools(retry.stdout or "", payload), retry.stdout[-4000:], retry.stderr[-1000:]


def _execute_paperclip_tool_calls(calls, payload):
    results = []
    for call in calls:
        if not isinstance(call, dict):
            results.append({"ok": False, "tool": None, "error": "Paperclip tool call must be a JSON object"})
            continue
        if "_parse_error" in call:
            results.append({"ok": False, "error": call["_parse_error"], "raw": call["_raw"]})
            continue
        try:
            result = _execute_tool_call(call, payload)
            tool_name = _canonical_tool_name(call)
            entry = {"ok": True, "tool": tool_name, "result": result}
            if tool_name == "paperclip_put_task_document":
                entry["documentKey"] = _document_key_from_call(call, payload)
            results.append(entry)
        except Exception as error:
            results.append({"ok": False, "tool": _canonical_tool_name(call), "error": str(error)})
    return results


def _compact_mapping(value, keys):
    return {
        key: value.get(key)
        for key in keys
        if isinstance(value, dict) and value.get(key) not in (None, "", [], {})
    }


def _compact_tool_value(value):
    if isinstance(value, list):
        return [_compact_tool_value(item) for item in value[:20]]
    if not isinstance(value, dict):
        return value

    if "identifier" in value and "title" in value:
        compact = _compact_mapping(
            value,
            (
                "id",
                "identifier",
                "title",
                "description",
                "status",
                "priority",
                "assigneeAgentId",
                "assigneeUserId",
                "projectId",
                "goalId",
                "parentId",
                "checkoutRunId",
                "updatedAt",
            ),
        )
        if isinstance(compact.get("description"), str):
            compact["description"] = compact["description"][:2000]
        return compact

    if "body" in value and ("issueId" in value or "authorAgentId" in value or "authorUserId" in value):
        compact = _compact_mapping(
            value,
            ("id", "issueId", "authorAgentId", "authorUserId", "createdByRunId", "body", "createdAt"),
        )
        if isinstance(compact.get("body"), str):
            compact["body"] = compact["body"][:2000]
        return compact

    if "routine" in value or "trigger" in value:
        return {
            key: _compact_tool_value(item)
            for key, item in value.items()
            if key in {"routine", "trigger"}
        }

    return _compact_mapping(
        value,
        (
            "id",
            "identifier",
            "title",
            "name",
            "type",
            "kind",
            "status",
            "priority",
            "role",
            "reportsTo",
            "assigneeAgentId",
            "requestedByAgentId",
            "projectId",
            "goalId",
            "routineId",
            "triggerId",
            "cronExpression",
            "timezone",
            "createdAt",
        ),
    ) or {key: _compact_tool_value(item) for key, item in list(value.items())[:12]}


def _compact_tool_results_for_prompt(results):
    compacted = []
    for item in results:
        if not isinstance(item, dict):
            compacted.append(item)
            continue
        compact = {
            "ok": item.get("ok"),
            "tool": item.get("tool"),
        }
        if "error" in item:
            compact["error"] = item.get("error")
        if "result" in item:
            compact["result"] = _compact_tool_value(item.get("result"))
        compacted.append({key: value for key, value in compact.items() if value not in (None, "", [], {})})
    return compacted


def _compact_agent(value):
    return _compact_mapping(
        value,
        ("id", "name", "title", "role", "reportsTo", "status", "urlKey", "adapterType"),
    )


def _preload_paperclip_task_context(payload, task_id):
    company_id = _clean_text(payload.get("companyId") or os.environ.get("PAPERCLIP_COMPANY_ID"), max_len=128)
    agent_id = _clean_text(payload.get("agentId") or os.environ.get("PAPERCLIP_AGENT_ID"), max_len=128)
    context = {}

    try:
        heartbeat_context = _paperclip_request(
            "GET",
            f"/issues/{urllib.parse.quote(str(task_id))}/heartbeat-context",
            agent_id=payload.get("agentId"),
        )
        if isinstance(heartbeat_context, dict):
            issue = heartbeat_context.get("issue")
            if isinstance(issue, dict):
                context["issue"] = _compact_tool_value(issue)
            if isinstance(heartbeat_context.get("commentCursor"), dict):
                context["commentCursor"] = _compact_mapping(
                    heartbeat_context["commentCursor"],
                    ("totalComments", "latestCommentId", "latestCommentAt"),
                )
            summary = heartbeat_context.get("continuationSummary")
            if isinstance(summary, dict) and summary.get("body"):
                context["continuationSummary"] = str(summary.get("body"))[:2000]
    except Exception as error:
        context["issueContextError"] = str(error)

    if company_id:
        try:
            agents = _paperclip_request(
                "GET",
                f"/companies/{urllib.parse.quote(company_id)}/agents",
                agent_id=payload.get("agentId"),
            )
            if isinstance(agents, list):
                compact_agents = [_compact_agent(agent) for agent in agents if isinstance(agent, dict)]
                context["directReports"] = [
                    agent for agent in compact_agents if str(agent.get("reportsTo") or "") == agent_id
                ]
                context["companyAgents"] = compact_agents[:50]
        except Exception as error:
            context["agentRosterError"] = str(error)

    return context


def _lock_key(payload):
    return (
        str(payload.get("logicalAgentId") or "").strip()
        or str(os.environ.get("MONOLITH_LOGICAL_AGENT_ID") or "").strip()
        or str(payload.get("agentId") or "").strip()
        or str(os.environ.get("PAPERCLIP_AGENT_ID") or "").strip()
        or "default-agent"
    )


def _acquire_lock(payload):
    os.makedirs(LOCK_DIR, exist_ok=True)
    lock_key = _lock_key(payload).replace("/", "_")
    lock_path = os.path.join(LOCK_DIR, f"{lock_key}.lock")
    started = time.monotonic()
    lock_file = open(lock_path, "a+", encoding="utf-8")
    while True:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            lock_file.seek(0)
            lock_file.truncate()
            lock_file.write(
                json.dumps(
                    {
                        "runId": payload.get("runId"),
                        "agentId": payload.get("agentId"),
                        "logicalAgentId": payload.get("logicalAgentId"),
                        "brainId": payload.get("brainId"),
                        "acquiredAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                    },
                    sort_keys=True,
                )
            )
            lock_file.flush()
            return lock_file, lock_path
        except OSError as exc:
            if exc.errno not in {errno.EACCES, errno.EAGAIN}:
                lock_file.close()
                raise
            if time.monotonic() - started >= LOCK_WAIT_SEC:
                lock_file.close()
                return None, lock_path
            time.sleep(0.2)


def _release_lock(lock_file):
    if lock_file is None:
        return
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
    finally:
        lock_file.close()


def _run_hermes_prompt(prompt, payload, timeout):
    cmd = [
        "sudo",
        "-E",
        "-u",
        "agent",
        "/home/agent/hermes-agent/venv/bin/python",
        "-m",
        "hermes_cli.main",
        "chat",
        "-Q",
        "--source",
        "paperclip",
        "-q",
        prompt,
    ]
    process = subprocess.Popen(
        cmd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=_hermes_env(payload),
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as error:
        try:
            os.killpg(process.pid, signal.SIGTERM)
            stdout, stderr = process.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            stdout, stderr = process.communicate()
        error.stdout = stdout
        error.stderr = stderr
        raise error
    return subprocess.CompletedProcess(cmd, process.returncode, stdout, stderr)


def run_hermes(payload):
    run_id = payload.get("runId")
    agent_id = payload.get("agentId")
    company_id = payload.get("companyId")
    context = payload.get("context") if isinstance(payload.get("context"), dict) else {}
    compact_context = _compact_prompt_context(payload)
    task_id = context.get("taskId") or payload.get("taskId")
    wake_reason = context.get("wakeReason") or payload.get("wakeReason")
    if task_id:
        preloaded_paperclip_context = _preload_paperclip_task_context(payload, task_id)
        preloaded_issue = (
            preloaded_paperclip_context.get("issue")
            if isinstance(preloaded_paperclip_context, dict)
            and isinstance(preloaded_paperclip_context.get("issue"), dict)
            else {}
        )
        if preloaded_issue.get("status") in {"cancelled", "done"}:
            return {
                "exitCode": 0,
                "stdout": f"Skipping stale wake for terminal Paperclip task {task_id}.",
                "stderr": "",
                "toolResults": [],
            }
        prompt = (
            "Paperclip invoked you through the Monolith HTTP adapter. "
            "Treat Paperclip as the source of truth for task assignment and reporting. "
            "Do not ask for clarification. "
            "Do not run inline Python with -c/-e, package probes, or ad hoc scripts; "
            "those commands are denied in this runtime. Use the task's declared "
            "script/tool commands exactly, or emit the required Paperclip write "
            "for the task when the declared path is blocked. "
            "The assigned task context and your direct-report roster are already preloaded; "
            "act from that context before using Paperclip read tools. For Paperclip writes, do not use "
            "curl or raw HTTP. Instead emit exactly one line beginning with "
            f"{TOOL_CALL_PREFIX} followed by JSON. Allowed tools: {_allowed_tools_text()}. "
            "If the assigned task asks you to comment, report, delegate, update, close, "
            "or create Paperclip work, emitting the matching tool call is required; "
            "a plain acknowledgement without a tool call is a failed run. "
            "Use directReports when delegating to reports. "
            "Then respond concisely with the task/run status and next action. "
            f"runId={run_id}; agentId={agent_id}; companyId={company_id}; "
            f"taskId={task_id}; wakeReason={wake_reason}; "
            f"context={json.dumps(compact_context, sort_keys=True, separators=(',', ':'))}; "
            f"paperclipContext={json.dumps(preloaded_paperclip_context, sort_keys=True, separators=(',', ':'))}"
        )
    else:
        prompt = (
            "Paperclip invoked you through the Monolith HTTP adapter, but no taskId was "
            "provided for this wake. If the operator explicitly asks you to create, "
            "delegate, report, or comment in Paperclip, emit exactly one line beginning "
            f"with {TOOL_CALL_PREFIX} followed by JSON for one of these allowed tools: "
            f"{_allowed_tools_text()}. Otherwise respond "
            "briefly that you are online, ready for assignment, and waiting for a "
            "Paperclip task. "
            f"runId={run_id}; agentId={agent_id}; companyId={company_id}; "
            f"wakeReason={wake_reason}; "
            f"context={json.dumps(compact_context, sort_keys=True, separators=(',', ':'))}"
        )
    direct_tool_calls = context.get("paperclipToolCalls")
    direct_deterministic = None if direct_tool_calls else _run_direct_deterministic_report(payload, task_id) if task_id else None
    if direct_deterministic is not None:
        completed = subprocess.CompletedProcess(
            [],
            direct_deterministic["exitCode"],
            stdout=direct_deterministic["stdout"],
            stderr=direct_deterministic["stderr"],
        )
        tool_results = direct_deterministic["toolResults"]
        report_document_results = []
    elif isinstance(direct_tool_calls, list) and direct_tool_calls:
        completed = subprocess.CompletedProcess(args=[], returncode=0, stdout="", stderr="")
        tool_results = _execute_paperclip_tool_calls(direct_tool_calls, payload)
        report_document_results = []
    else:
        try:
            completed = _run_hermes_prompt(prompt, payload, HERMES_TIMEOUT_SEC)
            tool_results = _execute_paperclip_tools(completed.stdout or "", payload)
            if not tool_results:
                retry_results, retry_stdout, retry_stderr = _retry_missing_tool_calls(
                    completed,
                    payload,
                    task_id,
                    run_id,
                    agent_id,
                    company_id,
                    wake_reason,
                    prompt,
                )
                if retry_results:
                    tool_results = retry_results
                    completed = subprocess.CompletedProcess(
                        completed.args,
                        completed.returncode,
                        stdout=(completed.stdout or "")
                        + "\n\n--- Paperclip missing-tool retry ---\n"
                        + retry_stdout,
                        stderr=(completed.stderr or "") + ("\n" + retry_stderr if retry_stderr else ""),
                    )
                elif retry_stderr:
                    completed = subprocess.CompletedProcess(
                        completed.args,
                        completed.returncode,
                        stdout=completed.stdout,
                        stderr=(completed.stderr or "") + "\n" + retry_stderr,
                    )
        except subprocess.TimeoutExpired as error:
            completed = subprocess.CompletedProcess(
                getattr(error, "cmd", []),
                None,
                stdout=_timeout_text(error.stdout),
                stderr=("Hermes invocation timed out" + ("\n" + _timeout_text(error.stderr) if error.stderr else "")),
            )
            tool_results = []
        report_document_results = _ensure_report_document(
            tool_results,
            completed,
            payload,
            task_id,
            prompt,
        )
        if report_document_results:
            tool_results = [*tool_results, *report_document_results]
            if completed.returncode is None and _has_report_document_write(report_document_results):
                completed = subprocess.CompletedProcess(
                    completed.args,
                    0,
                    stdout=completed.stdout,
                    stderr=completed.stderr,
                )
    followup_stdout = ""
    followup_stderr = ""
    if tool_results and not report_document_results:
        compact_tool_results = _compact_tool_results_for_prompt(tool_results)
        followup_prompt = (
            "Paperclip gateway tool results are now available. Do not emit any "
            f"{TOOL_CALL_PREFIX} lines. Use these results to answer the operator, "
            "including identifiers, status, assignee, comments, delivery expectations, "
            "and next follow-up. "
            f"Original run context: runId={run_id}; agentId={agent_id}; companyId={company_id}; "
            f"taskId={task_id}; wakeReason={wake_reason}. "
            f"toolResults={json.dumps(compact_tool_results, sort_keys=True, default=str)}"
        )
        try:
            followup = _run_hermes_prompt(
                followup_prompt,
                payload,
                max(30, min(HERMES_TIMEOUT_SEC, 90)),
            )
            followup_stdout = followup.stdout[-4000:]
            followup_stderr = followup.stderr[-1000:]
        except Exception as error:
            followup_stderr = str(error)
    return {
        "exitCode": completed.returncode,
        "stdout": ((completed.stdout or "") + ("\n\n--- Paperclip tool follow-up ---\n" + followup_stdout if followup_stdout else ""))[-8000:],
        "stderr": ((completed.stderr or "") + ("\n" + followup_stderr if followup_stderr else ""))[-4000:],
        "toolResults": tool_results,
    }


def _enqueue_wake(payload):
    os.makedirs(QUEUE_DIR, exist_ok=True)
    enqueued_at = time.time()
    run_id = payload.get("runId") or hashlib.sha256(
        json.dumps(payload, sort_keys=True).encode("utf-8")
    ).hexdigest()[:16]
    filename = f"{int(enqueued_at * 1000)}-{run_id}.json"
    tmp_path = os.path.join(QUEUE_DIR, f".{filename}.tmp")
    final_path = os.path.join(QUEUE_DIR, filename)
    with open(tmp_path, "w", encoding="utf-8") as handle:
        json.dump({"enqueuedAt": enqueued_at, "payload": payload}, handle)
    os.rename(tmp_path, final_path)
    return {"queuePath": final_path, "runId": run_id, "enqueuedAt": enqueued_at}


def _drain_queue_once():
    if not os.path.isdir(QUEUE_DIR):
        return 0
    processed = 0
    for entry in sorted(os.listdir(QUEUE_DIR)):
        if entry.startswith("."):
            continue
        path = os.path.join(QUEUE_DIR, entry)
        try:
            with open(path, "r", encoding="utf-8") as handle:
                envelope = json.load(handle)
        except (OSError, json.JSONDecodeError):
            try:
                os.unlink(path)
            except OSError:
                pass
            continue
        payload = envelope.get("payload") or {}
        lock_file, lock_path = _acquire_lock(payload)
        if lock_file is None:
            return processed
        try:
            started = time.time()
            try:
                hermes = run_hermes(payload)
            except subprocess.TimeoutExpired as error:
                hermes = {
                    "exitCode": None,
                    "stdout": (error.stdout or "")[-8000:] if isinstance(error.stdout, str) else "",
                    "stderr": "Hermes invocation timed out",
                    "toolResults": [],
                }
            except Exception as error:
                hermes = {
                    "exitCode": None,
                    "stdout": "",
                    "stderr": str(error),
                    "toolResults": [],
                }
            record = {
                "receivedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "durationSec": round(time.time() - started, 3),
                "lockPath": lock_path,
                "mode": "async",
                "payload": payload,
                "hermes": hermes,
            }
            try:
                os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
                with open(LOG_PATH, "a", encoding="utf-8") as log:
                    log.write(json.dumps(record, sort_keys=True) + "\n")
            except OSError:
                pass
        finally:
            _release_lock(lock_file)
            try:
                os.unlink(path)
            except OSError:
                pass
        processed += 1
    return processed


def _worker_loop():
    while True:
        try:
            _drain_queue_once()
        except Exception:
            pass
        time.sleep(WORKER_POLL_SEC)


class Handler(BaseHTTPRequestHandler):
    server_version = "monolith-paperclip-gateway/1.0"

    def _send_json(self, status, body):
        payload = json.dumps(body, sort_keys=True).encode("utf-8")
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        if self.path == "/health":
            self._send_json(
                200,
                {
                    "status": "ok",
                    "runtime": "hermes",
                    "paperclipAgentId": os.environ.get("PAPERCLIP_AGENT_ID"),
                    "paperclipCompanyId": os.environ.get("PAPERCLIP_COMPANY_ID"),
                },
            )
            return
        self._send_json(404, {"error": "not_found"})

    def do_POST(self):
        if self.path != "/paperclip/wake":
            self._send_json(404, {"error": "not_found"})
            return

        length = int(self.headers.get("content-length", "0") or "0")
        raw = self.rfile.read(length)
        auth_error = _verify_request_auth(self.headers, raw)
        if auth_error:
            self._send_json(401, {"error": auth_error})
            return

        try:
            payload = json.loads(raw.decode("utf-8")) if raw else {}
        except json.JSONDecodeError:
            self._send_json(400, {"error": "invalid_json"})
            return

        if GATEWAY_MODE == "async":
            try:
                enq = _enqueue_wake(payload)
            except OSError as error:
                self._send_json(
                    500,
                    {
                        "error": "enqueue_failed",
                        "runtime": "hermes",
                        "mode": "async",
                        "detail": str(error),
                    },
                )
                return
            self._send_json(
                200,
                {
                    "ok": True,
                    "runtime": "hermes",
                    "mode": "async",
                    "agentId": payload.get("agentId"),
                    "runId": payload.get("runId") or enq["runId"],
                    "companyId": payload.get("companyId"),
                    "logicalAgentId": payload.get("logicalAgentId") or os.environ.get("MONOLITH_LOGICAL_AGENT_ID"),
                    "brainId": payload.get("brainId") or os.environ.get("MONOLITH_BRAIN_ID"),
                    "queuedAt": enq["enqueuedAt"],
                },
            )
            return

        lock_file, lock_path = _acquire_lock(payload)
        if lock_file is None:
            self._send_json(
                409,
                {
                    "error": "agent_busy",
                    "runtime": "hermes",
                    "agentId": payload.get("agentId"),
                    "runId": payload.get("runId"),
                    "logicalAgentId": payload.get("logicalAgentId") or os.environ.get("MONOLITH_LOGICAL_AGENT_ID"),
                    "lockPath": lock_path,
                },
            )
            return

        started = time.time()
        try:
            hermes = run_hermes(payload)
            ok = hermes["exitCode"] == 0
        except subprocess.TimeoutExpired as error:
            hermes = {
                "exitCode": None,
                "stdout": (error.stdout or "")[-8000:] if isinstance(error.stdout, str) else "",
                "stderr": "Hermes invocation timed out",
                "toolResults": [],
            }
            ok = False
        except Exception as error:
            hermes = {"exitCode": None, "stdout": "", "stderr": str(error), "toolResults": []}
            ok = False

        record = {
            "receivedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "durationSec": round(time.time() - started, 3),
            "lockPath": lock_path,
            "payload": payload,
            "hermes": hermes,
        }
        try:
            os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
            with open(LOG_PATH, "a", encoding="utf-8") as log:
                log.write(json.dumps(record, sort_keys=True) + "\n")
        finally:
            _release_lock(lock_file)

        self._send_json(
            200 if ok else 502,
            {
                "ok": ok,
                "runtime": "hermes",
                "agentId": payload.get("agentId"),
                "runId": payload.get("runId"),
                "companyId": payload.get("companyId"),
                "logicalAgentId": payload.get("logicalAgentId") or os.environ.get("MONOLITH_LOGICAL_AGENT_ID"),
                "brainId": payload.get("brainId") or os.environ.get("MONOLITH_BRAIN_ID"),
                "hermesExitCode": hermes["exitCode"],
                "hermesOutput": hermes["stdout"][-2000:],
                "hermesError": hermes["stderr"][-1000:],
                "paperclipToolResults": hermes.get("toolResults", []),
            },
        )


if __name__ == "__main__":
    if GATEWAY_MODE == "async":
        import threading

        threading.Thread(target=_worker_loop, daemon=True).start()
    ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
