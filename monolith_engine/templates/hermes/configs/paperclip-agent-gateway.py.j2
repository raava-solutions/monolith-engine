def _clean_status_list(value, *, default, allowed=None):
    raw = value if value not in (None, "", [], {}) else default
    if isinstance(raw, str):
        items = [item.strip().lower() for item in raw.split(",")]
    elif isinstance(raw, list):
        items = [str(item).strip().lower() for item in raw]
    else:
        items = [str(raw).strip().lower()]
    normalized = []
    for item in items:
        if not item or item in normalized:
            continue
        if allowed and item not in allowed:
            continue
        normalized.append(item)
    return normalized


def _clean_bool(value, *, default=False):
    if value in (None, ""):
        return default
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"1", "true", "yes", "y", "on", "enabled"}


def _bounded_limit(value, *, default=50, maximum=100):
    try:
        limit = int(value if value not in (None, "") else default)
    except (TypeError, ValueError):
        limit = default
    return max(1, min(maximum, limit))


def _encoded_query(values):
    query = {}
    for key, value in values.items():
        if value in (None, "", [], {}):
            continue
        if isinstance(value, list):
            query[key] = ",".join(str(item) for item in value if str(item).strip())
        else:
            query[key] = value
    return urllib.parse.urlencode(query)


