        issue_id = _issue_id_arg(args, payload, tool)
        return _paperclip_request("GET", f"/issues/{urllib.parse.quote(issue_id)}/documents", agent_id=payload.get("agentId"))

    if tool == "paperclip_get_task_document":
        issue_id = _issue_id_arg(args, payload, tool)
        key = _clean_text(_first_arg(args, "key", "document_key", "documentKey"), max_len=240)
