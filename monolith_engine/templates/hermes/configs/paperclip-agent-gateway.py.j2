def _extract_html_report_body(raw_text):
    text = _ANSI_RE.sub("", str(raw_text or "")).replace("#012", "\n")
    reconstructed_lines = []
    in_hunk = False
    capture_diff = False
    for line in text.splitlines():
        if line.startswith("@@"):
            in_hunk = True
            continue
        if not in_hunk or line.startswith("+++") or line.startswith("---"):
            continue
        content = None
        if line.startswith(" "):
            content = line[1:]
        elif line.startswith("+"):
            content = line[1:]
        elif line.startswith("-"):
            continue
        if content is None:
            continue
        if content.lstrip().startswith("<section"):
            capture_diff = True
        if capture_diff:
            reconstructed_lines.append(content)
    if reconstructed_lines:
        body = _first_complete_section("\n".join(reconstructed_lines))
        if body:
            return body[:20000]

    body = _first_complete_section(text)
    if body:
        return body[:20000]
    return ""


