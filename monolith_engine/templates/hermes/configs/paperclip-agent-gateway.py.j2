def _first_complete_section(text):
    start = str(text or "").find("<section")
    if start < 0:
        return ""
    lines = []
    depth = 0
    for line in str(text or "")[start:].splitlines():
        lines.append(line)
        depth += len(re.findall(r"<section\b", line))
        depth -= line.count("</section>")
        if depth <= 0 and "</section>" in line:
            body = "\n".join(lines).strip()
            return body if body.startswith("<section") else ""
    return ""


def _read_latest_prompt_html_report(prompt):
    directories = set()
    if "Alpha Engine Daily Tracker" in str(prompt or ""):
        directories.add("/home/agent/.hermes/data/alpha_engine/")
    for match in re.findall(r"(/home/agent/\.hermes/[A-Za-z0-9_./-]+/)", str(prompt or "")):
        directory = os.path.normpath(match) + os.sep
        if directory.startswith("/home/agent/.hermes/"):
            directories.add(directory)

    candidates = []
    for directory in directories:
        try:
            for name in os.listdir(directory):
                path = os.path.join(directory, name)
                if name.endswith(".html") and os.path.isfile(path):
                    candidates.append(path)
        except OSError:
            continue

    for path in sorted(candidates, key=lambda item: os.path.getmtime(item), reverse=True):
        try:
            with open(path, encoding="utf-8") as handle:
                body = handle.read().strip()
        except OSError:
            continue
        body = _first_complete_section(body)
        if body:
            return body[:20000]
    return ""


