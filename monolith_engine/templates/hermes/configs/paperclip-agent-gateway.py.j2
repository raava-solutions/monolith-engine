def _compact_prompt_context(payload):
    context = payload.get("context") if isinstance(payload.get("context"), dict) else {}
    compact = {
        key: context.get(key)
        for key in _PROMPT_CONTEXT_KEYS
        if context.get(key) not in (None, "", [], {})
    }

    workspace = context.get("paperclipWorkspace")
    if isinstance(workspace, dict):
        compact["paperclipWorkspace"] = {
            key: workspace.get(key)
            for key in (
                "cwd",
                "mode",
                "source",
                "repoRef",
                "repoUrl",
                "projectId",
                "branchName",
            )
            if workspace.get(key) not in (None, "", [], {})
        }

    environment = context.get("paperclipEnvironment")
    if isinstance(environment, dict):
        compact["paperclipEnvironment"] = {
            key: environment.get(key)
            for key in ("id", "name", "driver")
            if environment.get(key) not in (None, "", [], {})
        }

    return compact


def _api_root():
    return (os.environ.get("PAPERCLIP_API_URL") or "").strip().rstrip("/")


def _api_key(agent_id=None):
    key_map_raw = (os.environ.get("PAPERCLIP_AGENT_API_KEYS_JSON") or "").strip()
    if key_map_raw and agent_id:
        try:
            key_map = json.loads(key_map_raw)
        except json.JSONDecodeError:
            key_map = {}
        if isinstance(key_map, dict):
            mapped = str(key_map.get(str(agent_id)) or "").strip()
            if mapped:
                return mapped
    return (os.environ.get("PAPERCLIP_API_KEY") or "").strip()


def _header(headers, name):
    return (
        headers.get(name)
        or headers.get(name.lower())
        or headers.get("-".join(part.capitalize() for part in name.split("-")))
        or ""
    )


def _signature_hex(value):
    text = str(value or "").strip()
    if text.startswith("sha256="):
        return text.split("=", 1)[1].strip().lower()
    return text.lower()


def _gateway_signature(timestamp, raw_body):
    body = raw_body if isinstance(raw_body, bytes) else bytes(raw_body or b"")
    signed = str(timestamp).encode("utf-8") + b"." + body
    return hmac.new(HMAC_SECRET.encode("utf-8"), signed, hashlib.sha256).hexdigest()


def _record_replay_nonce(nonce):
    safe = hashlib.sha256(str(nonce).encode("utf-8")).hexdigest()
    os.makedirs(REPLAY_DIR, exist_ok=True)
    cutoff = time.time() - (SIGNATURE_TOLERANCE_SEC * 2)
    try:
        for entry in os.scandir(REPLAY_DIR):
            if entry.is_file() and entry.stat().st_mtime < cutoff:
                os.unlink(entry.path)
    except OSError:
        pass
    path = os.path.join(REPLAY_DIR, safe)
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
    try:
        fd = os.open(path, flags, 0o600)
    except FileExistsError:
        return False
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(str(time.time()))
    return True


def _verify_request_auth(headers, raw_body):
    shared_secret = _header(headers, "x-paperclip-gateway-secret")
    if not hmac.compare_digest(shared_secret, SECRET):
        return "unauthorized"

    signature = _header(headers, "x-paperclip-signature")
    if not signature and not REQUIRE_HMAC:
        return None
    if not signature:
        return "missing_signature"

    timestamp = _header(headers, "x-paperclip-timestamp")
    try:
        timestamp_sec = int(str(timestamp))
    except (TypeError, ValueError):
        return "invalid_signature_timestamp"
    if abs(time.time() - timestamp_sec) > SIGNATURE_TOLERANCE_SEC:
        return "stale_signature"

    expected = _gateway_signature(timestamp, raw_body)
    if not hmac.compare_digest(_signature_hex(signature), expected):
        return "invalid_signature"

    replay_key = _header(headers, "x-paperclip-idempotency-key") or f"{timestamp}:{signature}"
    if not _record_replay_nonce(replay_key):
        return "replayed_request"
    return None


class PaperclipRequestError(RuntimeError):
    def __init__(self, method, path, status, detail):
        self.method = method
        self.path = path
        self.status = status
        self.detail = detail
        super().__init__(f"Paperclip {method} {path} returned {status}: {detail[:500]}")


def _paperclip_request(method, path, body=None, agent_id=None, run_id=None):
    root = _api_root()
    token = _api_key(agent_id)
    if not root:
        raise RuntimeError("PAPERCLIP_API_URL is not configured")
    if not token:
        raise RuntimeError("PAPERCLIP_API_KEY is not configured")

    data = json.dumps(body).encode("utf-8") if body is not None else None
    headers = {
        "accept": "application/json",
        "authorization": f"Bearer {token}",
        "content-type": "application/json",
    }
    if run_id and _UUID_RE.match(str(run_id)):
        headers["X-Paperclip-Run-Id"] = str(run_id)

    request = urllib.request.Request(
        f"{root}{path}",
        data=data,
        method=method,
        headers=headers,
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            payload = response.read().decode("utf-8")
            return json.loads(payload) if payload else None
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")
        raise PaperclipRequestError(method, path, error.code, detail) from error
    except urllib.error.URLError as error:
        raise RuntimeError(f"Paperclip {method} {path} failed: {error.reason}") from error

def _clean_text(value, *, max_len):
    if value is None:
