        return _paperclip_request(
            "GET",
            f"/issues/{urllib.parse.quote(issue_id)}/documents/{urllib.parse.quote(key)}",
            agent_id=payload.get("agentId"),
        )

    if tool == "paperclip_put_task_document":
        issue_id = _issue_id_arg(args, payload, tool)
        key = _clean_text(_first_arg(args, "key", "document_key", "documentKey"), max_len=240)
        declared_key = _payload_report_document_key(payload)
        if declared_key:
            key = declared_key
        body_text = _clean_text(_first_arg(args, "body", "content", "markdown", "html"), max_len=20000)
        format_text = _clean_text(
            _first_arg(args, "format", "document_format", "documentFormat") or "markdown",
            max_len=32,
        ).lower()
        if not key:
            raise RuntimeError("paperclip_put_task_document requires key")
        if not body_text:
            raise RuntimeError("paperclip_put_task_document requires body")
        if format_text not in {"markdown", "html", "json"}:
            raise RuntimeError("paperclip_put_task_document format must be markdown, html, or json")
        if key == REPORT_CONTRACT_V1_KEY:
            _validate_report_contract_v1_body(body_text)
            # Paperclip documents currently support markdown/html formats only.
            # Store the raw JSON text as markdown so consumers can parse the body.
            format_text = "markdown"
        if format_text == "html":
            body_text = _style_report_document(body_text)
        request_body = {"body": body_text, "format": format_text}
        base_revision_id = _clean_text(
            _first_arg(args, "baseRevisionId", "base_revision_id", "baseRevision"),
            max_len=80,
        )
        if base_revision_id:
            request_body["baseRevisionId"] = base_revision_id
        path = f"/issues/{urllib.parse.quote(issue_id)}/documents/{urllib.parse.quote(key)}"
        try:
            return _paperclip_request(
                "PUT",
                path,
                request_body,
                payload.get("agentId"),
                run_id,
            )
        except PaperclipRequestError as error:
            message = error.detail
            if base_revision_id or "requires baseRevisionId" not in message:
                raise
            match = re.search(r'"currentRevisionId"\s*:\s*"([^"]+)"', message)
            if not match:
                raise
            request_body["baseRevisionId"] = match.group(1)
            return _paperclip_request(
                "PUT",
                path,
                request_body,
                payload.get("agentId"),
                run_id,
            )

    raise RuntimeError(f"Unsupported Paperclip tool: {tool}")


def _json_object_prefix(raw):
    text = _ANSI_RE.sub("", str(raw or "")).strip()
    if not text:
        raise json.JSONDecodeError("empty tool call", text, 0)

    candidates = (text.replace('\\"', '"'), text) if '\\"' in text else (text,)
    for candidate in candidates:
        start = candidate.find("{")
        if start < 0:
            continue
        depth = 0
        in_string = False
        escaped = False
        for index, char in enumerate(candidate[start:], start=start):
            if escaped:
                escaped = False
                continue
            if char == "\\":
                escaped = True
                continue
            if char == '"':
                in_string = not in_string
                continue
            if in_string:
                continue
            if char == "{":
                depth += 1
            elif char == "}":
                depth -= 1
                if depth == 0:
                    return candidate[start : index + 1]
    return text


def _extract_tool_calls(stdout):
    calls = []
    for line in (stdout or "").splitlines():
        stripped_line = line.lstrip()
        if stripped_line.startswith(f"+{TOOL_CALL_PREFIX}") or stripped_line.startswith(f"-{TOOL_CALL_PREFIX}"):
            continue
        if TOOL_CALL_PREFIX not in line:
            continue
        raw = line.split(TOOL_CALL_PREFIX, 1)[1].strip()
        if "{" not in raw:
            continue
        try:
            calls.append(json.loads(_json_object_prefix(raw)))
        except json.JSONDecodeError as error:
            calls.append({"_parse_error": str(error), "_raw": raw[:500]})
    return calls


def _execute_paperclip_tools(stdout, payload):
    return _execute_paperclip_tool_calls(_extract_tool_calls(stdout), payload)


