def _copy_clean_fields(args, field_map, *, max_len=8000):
    body = {}
    for source_keys, target_key in field_map:
        value = _first_arg(args, *source_keys)
        if isinstance(value, (dict, list, bool, int, float)):
            body[target_key] = value
            continue
        cleaned = _clean_text(value, max_len=max_len)
        if cleaned:
            body[target_key] = cleaned
    return body


def _clean_text_items(value, *, max_items=12, max_len=500):
    if value in (None, "", [], {}):
        return []
    if isinstance(value, str):
        raw_items = [line.strip(" -\t") for line in value.splitlines()]
    elif isinstance(value, list):
        raw_items = value
    else:
        raw_items = [value]
    items = []
    for item in raw_items:
        if isinstance(item, dict):
            label = (
                item.get("title")
                or item.get("name")
                or item.get("key")
                or item.get("document_key")
                or item.get("documentKey")
                or item.get("description")
            )
            detail = item.get("purpose") or item.get("format") or item.get("review")
            text = f"{label}: {detail}" if label and detail else label
        else:
            text = item
        cleaned = _clean_text(text, max_len=max_len)
        if cleaned:
            items.append(cleaned)
        if len(items) >= max_items:
            break
    return items


def _delegation_contract_from_args(args):
    work_mode = _clean_text(_first_arg(args, "work_mode", "workMode", "mode"), max_len=80).lower()
    owner = _clean_text(_first_arg(args, "owner", "owner_agent", "ownerAgent"), max_len=160)
    acceptance = _clean_text_items(
        _first_arg(args, "acceptance_criteria", "acceptanceCriteria", "acceptance"),
        max_items=10,
    )
    expected_documents = _clean_text_items(
        _first_arg(args, "expected_documents", "expectedDocuments", "documents"),
        max_items=8,
    )
    blocker_policy = _clean_text_items(
        _first_arg(args, "blocker_policy", "blockerPolicy", "blockers"),
        max_items=8,
    )
    review_policy = _clean_text_items(
        _first_arg(args, "review_policy", "reviewPolicy", "review"),
        max_items=8,
    )

    if not any([work_mode, owner, acceptance, expected_documents, blocker_policy, review_policy]):
        return ""

    lines = ["## Monolith Paperclip Delegation Contract"]
    if work_mode:
        lines.append(f"- work_mode: {work_mode}")
    if owner:
        lines.append(f"- owner: {owner}")
    if acceptance:
        lines.append("- acceptance_criteria:")
        lines.extend([f"  - {item}" for item in acceptance])
    if expected_documents:
        lines.append("- expected_output_documents:")
        lines.extend([f"  - {item}" for item in expected_documents])
    if blocker_policy:
        lines.append("- blocker_policy:")
        lines.extend([f"  - {item}" for item in blocker_policy])
    if review_policy:
        lines.append("- review_policy:")
        lines.extend([f"  - {item}" for item in review_policy])
    if work_mode == "planning":
        lines.append("- planning_rule: do not implement on this issue; create executable child issues after plan acceptance")
    return "\n".join(lines)


def _resolve_report_agent_id(value, payload, company_id):
    target = _normal_key(value)
    if not target:
        return None
    agents = _paperclip_request(
        "GET",
        f"/companies/{urllib.parse.quote(company_id)}/agents",
        agent_id=payload.get("agentId"),
    )
    if not isinstance(agents, list):
        return None
    self_agent_id = str(payload.get("agentId") or os.environ.get("PAPERCLIP_AGENT_ID") or "")
    compact_agents = [agent for agent in agents if isinstance(agent, dict)]
    direct_reports = [
        agent for agent in compact_agents if str(agent.get("reportsTo") or "") == self_agent_id
    ]
    for scope in (direct_reports, compact_agents):
        for agent in scope:
            candidates = (
                agent.get("id"),
                agent.get("name"),
                agent.get("urlKey"),
                agent.get("title"),
            )
            if target in {_normal_key(candidate) for candidate in candidates if candidate}:
                return agent.get("id")
    return None


def _execute_tool_call(call, payload):
    if not isinstance(call, dict):
        raise RuntimeError("Tool call must be a JSON object")
    tool = _canonical_tool_name(call)
    args = (
        call.get("args")
        if isinstance(call.get("args"), dict)
        else call.get("params")
        if isinstance(call.get("params"), dict)
        else call.get("parameters")
        if isinstance(call.get("parameters"), dict)
        else call.get("arguments")
        if isinstance(call.get("arguments"), dict)
        else {key: value for key, value in call.items() if key not in {"tool", "name", "action"}}
    )
    company_id = _clean_text(
        args.get("company_id") or payload.get("companyId") or os.environ.get("PAPERCLIP_COMPANY_ID"),
        max_len=128,
    )
    run_id = payload.get("runId")
    if not company_id:
        raise RuntimeError("Paperclip company id is required")

    if tool == "paperclip_get_me":
        return _paperclip_request("GET", "/agents/me", agent_id=payload.get("agentId"))

    if tool == "paperclip_get_inbox":
        return _paperclip_request("GET", "/agents/me/inbox-lite", agent_id=payload.get("agentId"))

    if tool == "paperclip_list_agents":
        return _paperclip_request(
