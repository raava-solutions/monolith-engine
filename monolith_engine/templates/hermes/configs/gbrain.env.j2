# Rendered by raava-fleet-api at provision time. For raava-tenant agents the
# provisioner mints a per-agent OAuth client via the
# raava-brain-gbrain-mint-client Cloud Run job and populates client_id/secret;
# for customer-tenant agents those fields render empty and provision.sh's
# `grep -E "^GBRAIN_CLIENT_ID=[^[:space:]]+"` gate skips the install entirely.
# Consumed by /usr/local/bin/gbrain (the read-only MCP shim) via the
# /etc/systemd/system/hermes-gateway.service.d/gbrain.conf drop-in.
GBRAIN_URL={{ gbrain_url | default("https://raava-brain-gbrain-lmbn6fkciq-ue.a.run.app") }}
GBRAIN_CLIENT_ID={{ gbrain_client_id | default("") }}
GBRAIN_CLIENT_SECRET={{ gbrain_client_secret | default("") }}
GBRAIN_GCP=1
