# {{ agent_name }} — secrets (mode: {{ secrets_mode }})
{% if secrets_mode == 'env' %}
# Loaded via EnvironmentFile
{% for secret in secrets %}
{{ secret.env_var }}={{ secret.value | env_value }}
{% endfor %}
{% endif %}

{% if model_provider in ('ollama', 'endpoint') %}
# Local model provider: no cloud key. OPENAI_BASE_URL marks the provider as
# configured for Hermes' first-run detection and points the OpenAI-compatible
# client at the endpoint.
OPENAI_BASE_URL={{ model_base_url | default('http://host.docker.internal:11434/v1') }}
{% endif %}

# Monolith runtime envelope
MONOLITH_RUNTIME_ENVELOPE={{ runtime_envelope | default("hermes_alpha") }}
MONOLITH_RUNTIME_CONTRACT_VERSION={{ runtime_contract_version | default("1") }}
MONOLITH_HERMES_HOME={{ hermes_home | default("/home/agent/.hermes") }}
MONOLITH_GATEWAY_SERVICE={{ runtime_gateway_service | default("hermes-gateway") }}
MONOLITH_PERSISTENT_PATHS={{ runtime_persistent_paths | default("/home/agent/.hermes,/home/agent/.config/hermes,/home/agent/workspace") }}
MONOLITH_SIDECAR_SERVICES={{ runtime_sidecar_services | default("") }}
MONOLITH_RUNTIME_HEALTH_COMMAND={{ runtime_health_command | default("systemctl is-active --quiet hermes-gateway && test -d /home/agent/.hermes") | env_value }}
MONOLITH_HUD_ENABLED={{ "true" if hud_enabled is not defined or hud_enabled else "false" }}
MONOLITH_HUD_TENANT_ID={{ tenant_id }}
MONOLITH_HUD_AGENT_NAME={{ agent_slug }}
MONOLITH_HUD_CONTAINER_ID={{ container_name }}
MONOLITH_HUD_SAMPLE_INTERVAL_SECONDS={{ hud_sample_interval_seconds | default(60) }}
{% if hud_ingest_url is defined and hud_ingest_url %}
MONOLITH_HUD_INGEST_URL={{ hud_ingest_url | env_value }}
{% endif %}
HERMES_CAMEL_GUARD_MODE={{ camel_guard_effective_mode | default("off") }}
MONOLITH_CAMEL_GUARD_REQUESTED_MODE={{ camel_guard_requested_mode | default(camel_guard_mode | default("off")) }}
MONOLITH_CAMEL_GUARD_ENFORCEMENT_ENABLED={{ "true" if camel_guard_enforcement_enabled is defined and camel_guard_enforcement_enabled else "false" }}
MONOLITH_CAMEL_GUARD_SOURCE=monolith-fleet-api
{% if trace_enabled is defined and trace_enabled %}

# Monolith observability
MONOLITH_TRACE_ENABLED=true
MONOLITH_TRACE_TENANT_ID={{ tenant_id }}
MONOLITH_TRACE_AGENT_NAME={{ agent_slug }}
MONOLITH_TRACE_CONTAINER_ID={{ container_name }}
{% if trace_ingest_url is defined and trace_ingest_url %}
MONOLITH_TRACE_INGEST_URL={{ trace_ingest_url }}
{% endif %}
{% if trace_ingest_api_key is defined and trace_ingest_api_key %}
MONOLITH_TRACE_INGEST_API_KEY={{ trace_ingest_api_key }}
{% endif %}
{% if observability_proxy_url is defined and observability_proxy_url %}
MONOLITH_OBSERVABILITY_PROXY_URL={{ observability_proxy_url }}
{% endif %}
OTEL_SERVICE_NAME={{ otel_service_name | default(container_name) }}
{% if otel_exporter_otlp_endpoint is defined and otel_exporter_otlp_endpoint %}
OTEL_EXPORTER_OTLP_ENDPOINT={{ otel_exporter_otlp_endpoint }}
{% endif %}
OTEL_RESOURCE_ATTRIBUTES={{ otel_resource_attributes | default('tenant_id=' ~ tenant_id ~ ',agent_name=' ~ agent_slug ~ ',container_id=' ~ container_name) }}
{% endif %}
{% if paperclip_enabled is defined and paperclip_enabled %}

# Paperclip workforce context
PAPERCLIP_API_URL={{ paperclip_api_url }}
PAPERCLIP_COMPANY_ID={{ paperclip_company_id }}
PAPERCLIP_AGENT_ID={{ paperclip_agent_id }}
PAPERCLIP_REPORTS_TO_AGENT_ID={{ paperclip_reports_to_agent_id }}
PAPERCLIP_ROLE={{ paperclip_role }}
PAPERCLIP_TITLE={{ paperclip_title | env_value }}
PAPERCLIP_API_KEY={{ paperclip_agent_api_key }}
{% if paperclip_agent_api_keys_json is defined and paperclip_agent_api_keys_json %}
PAPERCLIP_AGENT_API_KEYS_JSON={{ paperclip_agent_api_keys_json }}
{% endif %}
PAPERCLIP_GATEWAY_SECRET={{ paperclip_gateway_secret }}
PAPERCLIP_GATEWAY_BIND_HOST={{ paperclip_gateway_bind_host | default("127.0.0.1") }}
PAPERCLIP_GATEWAY_MODE={{ paperclip_gateway_mode | default("sync") }}
{% endif %}
