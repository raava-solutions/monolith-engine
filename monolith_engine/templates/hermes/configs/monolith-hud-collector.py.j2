#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

COLLECTOR_VERSION = "1"


def run(cmd: list[str], timeout: int = 5) -> dict:
    try:
        completed = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        return {
            "ok": completed.returncode == 0,
            "stdout": completed.stdout.strip(),
            "stderr": completed.stderr.strip(),
            "exit_code": completed.returncode,
        }
    except Exception as exc:
        return {"ok": False, "stdout": "", "stderr": f"{exc.__class__.__name__}: {exc}", "exit_code": None}


def file_status(path: Path) -> dict:
    try:
        stat = path.stat()
        return {"exists": True, "bytes": stat.st_size, "modified_at": datetime.fromtimestamp(stat.st_mtime, timezone.utc).isoformat()}
    except OSError:
        return {"exists": False, "bytes": 0, "modified_at": None}


def split_entries(path: Path) -> int:
    try:
        content = path.read_text(encoding="utf-8")
    except OSError:
        return 0
    return len([part for part in content.split("§") if part.strip()])


def sqlite_count(db_path: Path, table: str) -> int:
    if not db_path.exists():
        return 0
    try:
        with sqlite3.connect(str(db_path)) as conn:
            row = conn.execute(f"SELECT COUNT(*) FROM {table}").fetchone()
            return int(row[0] or 0) if row else 0
    except Exception:
        return 0


def collect_processes() -> dict:
    candidates = ["hermes_cli.main gateway", "hermes", "claude", "codex", "opencode"]
    processes = []
    for pattern in candidates:
        result = run(["pgrep", "-f", pattern])
        pids = [int(pid) for pid in result["stdout"].split() if pid.isdigit()]
        processes.append({"name": pattern, "running": bool(pids), "count": len(pids), "pids": pids[:5]})
    return {"live_count": sum(1 for item in processes if item["running"]), "processes": processes}


def collect_tmux_wait_states() -> dict:
    panes = run(["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{session_name}\t#{window_index}\t#{pane_index}\t#{pane_current_command}"])
    if not panes["ok"] or not panes["stdout"]:
        return {"available": False, "pane_count": 0, "alerts": []}
    alerts = []
    pane_count = 0
    for line in panes["stdout"].splitlines():
        pane_count += 1
        parts = line.split("\t")
        if not parts:
            continue
        pane_id = parts[0]
        capture = run(["tmux", "capture-pane", "-t", pane_id, "-p", "-S", "-5"])
        tail = capture["stdout"].lower()
        alert_type = None
        if any(word in tail for word in ("approve", "allow", "proceed?", "continue?")):
            alert_type = "approval"
        elif any(word in tail for word in ("traceback", "exception", "fatal", "failed")):
            alert_type = "error"
        elif "?" in tail:
            alert_type = "question"
        if alert_type:
            alerts.append({"pane_id": pane_id, "type": alert_type})
    return {"available": True, "pane_count": pane_count, "alerts": alerts[:20]}


def collect_snapshot() -> dict:
    hermes_home = Path(os.environ.get("MONOLITH_HERMES_HOME") or os.environ.get("HERMES_HOME") or "/home/agent/.hermes")
    memories = hermes_home / "memories"
    memory_file = memories / "MEMORY.md"
    user_file = memories / "USER.md"
    state_db = hermes_home / "state.db"
    gateway_service = os.environ.get("MONOLITH_GATEWAY_SERVICE", "hermes-gateway")
    systemd = run(["systemctl", "show", gateway_service, "--property=LoadState,ActiveState,SubState,MainPID,NRestarts", "--no-pager"])
    systemd_fields = {}
    for line in systemd["stdout"].splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            systemd_fields[key] = value

    snapshot = {
        "tenant_id": os.environ.get("MONOLITH_HUD_TENANT_ID") or os.environ.get("MONOLITH_TRACE_TENANT_ID") or "{{ tenant_id }}",
        "container_id": os.environ.get("MONOLITH_HUD_CONTAINER_ID") or os.environ.get("MONOLITH_TRACE_CONTAINER_ID") or "{{ container_name }}",
        "agent_name": os.environ.get("MONOLITH_HUD_AGENT_NAME") or os.environ.get("MONOLITH_TRACE_AGENT_NAME") or "{{ agent_slug }}",
        "environment": os.environ.get("MONOLITH_ENV") or "{{ stage | default('production') }}",
        "runtime_envelope": os.environ.get("MONOLITH_RUNTIME_ENVELOPE", "hermes_alpha"),
        "collector_version": COLLECTOR_VERSION,
        "collected_at": datetime.now(timezone.utc).isoformat(),
        "memory": {
            "home": file_status(hermes_home),
            "memory_file": file_status(memory_file),
            "memory_entry_count": split_entries(memory_file),
            "user_file": file_status(user_file),
            "user_entry_count": split_entries(user_file),
        },
        "sessions": {
            "state_db": file_status(state_db),
            "session_count": sqlite_count(state_db, "sessions"),
            "message_count": sqlite_count(state_db, "messages"),
        },
        "profiles": {
            "config_present": (hermes_home / "config.yaml").exists(),
            "soul_present": (hermes_home / "SOUL.md").exists(),
        },
        "skills": {"skill_count": len(list((hermes_home / "skills").glob("*/SKILL.md"))) if (hermes_home / "skills").exists() else 0},
        "cron": {"job_count": sqlite_count(state_db, "cron_jobs")},
        "corrections": {"file_present": (memories / "CORRECTIONS.md").exists()},
        "patterns": {"available": state_db.exists()},
        "processes": collect_processes() | {"tmux": collect_tmux_wait_states()},
        "gateway": {
            "service": gateway_service,
            "load_state": systemd_fields.get("LoadState"),
            "active_state": systemd_fields.get("ActiveState"),
            "sub_state": systemd_fields.get("SubState"),
            "main_pid": int(systemd_fields.get("MainPID") or 0),
            "restart_count": int(systemd_fields.get("NRestarts") or 0),
        },
        "policy": {
            "camel_guard_mode": os.environ.get("HERMES_CAMEL_GUARD_MODE", "off"),
            "camel_guard_enforcement_enabled": os.environ.get("MONOLITH_CAMEL_GUARD_ENFORCEMENT_ENABLED", "").lower() == "true",
        },
        "health": {
            "ok": systemd_fields.get("ActiveState") == "active" and hermes_home.exists(),
            "hermes_home_exists": hermes_home.exists(),
        },
    }
    return snapshot


def post_snapshot(snapshot: dict) -> None:
    base_url = os.environ.get("MONOLITH_HUD_INGEST_URL", "").rstrip("/")
    api_key = os.environ.get("MONOLITH_HUD_INGEST_API_KEY") or os.environ.get("MONOLITH_TRACE_INGEST_API_KEY")
    if not base_url or not api_key:
        raise RuntimeError("MONOLITH_HUD_INGEST_URL and MONOLITH_HUD_INGEST_API_KEY are required for posting")
    url = f"{base_url}/api/agents/{snapshot['container_id']}/hud/ingest"
    body = json.dumps(snapshot).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=body,
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        response.read()


def main() -> int:
    parser = argparse.ArgumentParser(description="Collect redacted Monolith Hermes HUD telemetry")
    parser.add_argument("--post", action="store_true", help="Post the snapshot to Fleet API")
    args = parser.parse_args()
    snapshot = collect_snapshot()
    if args.post:
        post_snapshot(snapshot)
    print(json.dumps(snapshot, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
