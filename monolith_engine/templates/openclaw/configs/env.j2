# Direct env file for OpenClaw without 1Password runtime wrapping
{% if model_provider in ('ollama', 'endpoint') -%}
# Local model provider: no cloud key. The local provider entry in
# openclaw.json carries the endpoint; OPENAI_BASE_URL is exported for
# parity with the hermes templates and any OpenAI-compatible tooling.
OPENAI_BASE_URL={{ model_base_url | default('http://host.docker.internal:11434/v1') }}
{% else -%}
OPENROUTER_API_KEY={{ openrouter_api_key | default('') }}
{% endif -%}
