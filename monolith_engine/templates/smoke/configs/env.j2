# Smoke agent runtime env (mode: {{ secrets_mode | default('bridge') }})
{% if bridge_mode is defined and bridge_mode -%}
# Bridge mode (credentials-vault §U5): NO provider key in the guest. The
# host-side LLM gateway attaches the provider key at call time. The run token
# (RAAVA_RUN_TOKEN) is injected into the guest at microVM create by the Fleet
# API — not rendered here. Hermes points at the bridge via OPENROUTER_BASE_URL.
OPENROUTER_BASE_URL={{ bridge_llm_base_url | default('http://172.31.0.1:8088/v1') }}
{% else -%}
OPENROUTER_API_KEY={{ openrouter_api_key | default('') }}
{% endif -%}
