[Unit]
Description=Smoke Gateway — {{ agent_name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/.smoke/workspace
ExecStart=/usr/bin/python3 -m http.server 18888 --bind 0.0.0.0 --directory /home/agent/.smoke/workspace
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
