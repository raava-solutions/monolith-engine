# Optional direct env file for Hermes without 1Password runtime wrapping
{% if bridge_mode is defined and bridge_mode -%}
# Bridge mode (credentials-vault §U5): NO provider key in the guest. The
# host-side LLM gateway attaches the OpenRouter key at call time. Hermes points
# at the bridge via OPENROUTER_BASE_URL; the run token (RAAVA_RUN_TOKEN) is
# injected into the guest at microVM create by the Fleet API, not rendered here.
OPENROUTER_BASE_URL={{ bridge_llm_base_url | default('http://172.31.0.1:8088/v1') }}
{% elif model_provider in ('ollama', 'endpoint') -%}
# Local model provider: no cloud key. OPENAI_BASE_URL marks the provider as
# configured for Hermes' first-run detection (a base URL alone counts for
# local models) and points the OpenAI-compatible client at the endpoint.
OPENAI_BASE_URL={{ model_base_url | default('http://host.docker.internal:11434/v1') }}
{% else -%}
OPENROUTER_API_KEY={{ openrouter_api_key | default('') }}
{% endif -%}
