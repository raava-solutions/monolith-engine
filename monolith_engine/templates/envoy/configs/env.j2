# {{ agent_name }} - envoy runtime env (mode: {{ secrets_mode }})
{% if secrets_mode == 'env' %}
{% for secret in secrets %}
{{ secret.env_var }}={{ secret.value | env_value }}
{% endfor %}
{% endif %}

# Monolith runtime envelope
MONOLITH_RUNTIME_ENVELOPE={{ runtime_envelope | default("hermes_alpha") }}
MONOLITH_RUNTIME_CONTRACT_VERSION={{ runtime_contract_version | default("1") }}
MONOLITH_HERMES_HOME={{ hermes_home | default("/home/agent/.hermes") }}
MONOLITH_GATEWAY_SERVICE={{ runtime_gateway_service | default("hermes-gateway") }}
MONOLITH_PERSISTENT_PATHS={{ runtime_persistent_paths | default("/home/agent/.hermes,/home/agent/.config/hermes,/home/agent/workspace") }}
MONOLITH_SIDECAR_SERVICES={{ runtime_sidecar_services | default("") }}
MONOLITH_RUNTIME_HEALTH_COMMAND={{ runtime_health_command | default("systemctl is-active --quiet hermes-gateway && test -d /home/agent/.hermes") | env_value }}
MONOLITH_HUD_ENABLED={{ "true" if hud_enabled is not defined or hud_enabled else "false" }}
MONOLITH_HUD_TENANT_ID={{ tenant_id }}
MONOLITH_HUD_AGENT_NAME={{ agent_slug }}
MONOLITH_HUD_CONTAINER_ID={{ container_name }}
MONOLITH_HUD_SAMPLE_INTERVAL_SECONDS={{ hud_sample_interval_seconds | default(60) }}
{% if hud_ingest_url is defined and hud_ingest_url %}
MONOLITH_HUD_INGEST_URL={{ hud_ingest_url | env_value }}
{% endif %}
{% if trace_enabled is defined and trace_enabled %}
MONOLITH_TRACE_ENABLED=true
MONOLITH_TRACE_TENANT_ID={{ tenant_id }}
MONOLITH_TRACE_AGENT_NAME={{ agent_slug }}
MONOLITH_TRACE_CONTAINER_ID={{ container_name }}
{% if trace_ingest_url is defined and trace_ingest_url %}
MONOLITH_TRACE_INGEST_URL={{ trace_ingest_url }}
{% endif %}
{% if trace_ingest_api_key is defined and trace_ingest_api_key %}
MONOLITH_TRACE_INGEST_API_KEY={{ trace_ingest_api_key }}
{% endif %}
{% if observability_proxy_url is defined and observability_proxy_url %}
MONOLITH_OBSERVABILITY_PROXY_URL={{ observability_proxy_url }}
{% endif %}
OTEL_SERVICE_NAME={{ otel_service_name | default(container_name) }}
{% if otel_exporter_otlp_endpoint is defined and otel_exporter_otlp_endpoint %}
OTEL_EXPORTER_OTLP_ENDPOINT={{ otel_exporter_otlp_endpoint }}
{% endif %}
OTEL_RESOURCE_ATTRIBUTES={{ otel_resource_attributes | default('tenant_id=' ~ tenant_id ~ ',agent_name=' ~ agent_slug ~ ',container_id=' ~ container_name) }}
{% endif %}
{% if discord_channel is defined and discord_channel %}

# Discord operator surface
DISCORD_HOME_CHANNEL={{ discord_channel }}
DISCORD_REQUIRE_MENTION=true
{% endif %}
{% if discord_guild_id is defined and discord_guild_id %}
DISCORD_GUILD_ID={{ discord_guild_id }}
{% endif %}
{% if discord_allowed_users is defined and discord_allowed_users %}
DISCORD_ALLOWED_USERS={{ discord_allowed_users | env_value }}
{% endif %}
{% if discord_free_response_channels is defined and discord_free_response_channels %}
DISCORD_FREE_RESPONSE_CHANNELS={{ discord_free_response_channels | env_value }}
{% elif a2a_discord_enabled is defined and a2a_discord_enabled and a2a_discord_channel_id is defined and a2a_discord_channel_id %}
DISCORD_FREE_RESPONSE_CHANNELS={{ a2a_discord_channel_id | env_value }}
{% endif %}
{% if a2a_discord_enabled is defined and a2a_discord_enabled %}

# Discord A2A guardrails
A2A_DISCORD_ENABLED=true
DISCORD_ALLOW_BOTS=mentions
{% if a2a_discord_channel_id is defined and a2a_discord_channel_id %}
A2A_DISCORD_CHANNEL_ID={{ a2a_discord_channel_id | env_value }}
{% endif %}
{% if a2a_discord_peer_name is defined and a2a_discord_peer_name %}
A2A_DISCORD_PEER_NAME={{ a2a_discord_peer_name | env_value }}
{% endif %}
{% if a2a_discord_peer_user_id is defined and a2a_discord_peer_user_id %}
A2A_DISCORD_PEER_USER_ID={{ a2a_discord_peer_user_id | env_value }}
{% endif %}
A2A_DISCORD_MAX_TURNS={{ a2a_discord_max_turns | default(12) }}
A2A_DISCORD_IDLE_SECONDS={{ a2a_discord_idle_seconds | default(900) }}
{% endif %}

# Envoy Paperclip operator context
ENVOY_OPERATOR=Zay
ENVOY_DISCORD_HANDLE=@envoy
ENVOY_DELEGATE_TASK_LIMIT={{ envoy_delegate_task_limit | default(3) }}
PAPERCLIP_OPERATOR_AUTH_MODE={{ paperclip_operator_auth_mode | default("operator") }}
{% if paperclip_operator_api_url is defined and paperclip_operator_api_url %}
PAPERCLIP_OPERATOR_API_URL={{ paperclip_operator_api_url | env_value }}
{% elif paperclip_api_url is defined and paperclip_api_url %}
PAPERCLIP_OPERATOR_API_URL={{ paperclip_api_url | env_value }}
{% endif %}
{% if paperclip_operator_api_key is defined and paperclip_operator_api_key %}
PAPERCLIP_OPERATOR_API_KEY={{ paperclip_operator_api_key | env_value }}
{% endif %}
{% if paperclip_company_keys_json is defined and paperclip_company_keys_json %}
PAPERCLIP_COMPANY_KEYS_JSON={{ paperclip_company_keys_json | env_value }}
{% endif %}
{% if paperclip_company_registry_json is defined and paperclip_company_registry_json %}
PAPERCLIP_COMPANY_REGISTRY_JSON={{ paperclip_company_registry_json | env_value }}
{% endif %}
{% if linear_argus_project_key is defined and linear_argus_project_key %}
ENVOY_LINEAR_ARGUS_PROJECT={{ linear_argus_project_key | env_value }}
{% endif %}
