model:
  provider: {{ (model_provider | default('openrouter')) | tojson }}
  default: {{ (model | default('minimax/minimax-m2.5')) | tojson }}
{% if model_provider == 'openrouter' %}
{% if trace_enabled is defined and trace_enabled and observability_proxy_url is defined and observability_proxy_url %}
  base_url: {{ observability_proxy_url | tojson }}
{% else %}
  base_url: https://openrouter.ai/api/v1
{% endif %}
{% elif model_provider == 'minimax' %}
  base_url: https://api.minimax.io/anthropic
{% elif model_provider == 'moonshot' %}
  base_url: https://api.moonshot.ai/v1
{% elif model_provider == 'ollama' %}
  base_url: {{ (model_base_url | default('http://host.docker.internal:11434/v1')) | tojson }}
{% elif model_provider == 'endpoint' %}
  base_url: {{ model_base_url | tojson }}
{% endif %}
toolsets:
- hermes-cli
agent:
  max_turns: 90
terminal:
  backend: local
  cwd: /home/agent/workspace
  timeout: 180
browser:
  inactivity_timeout: 120
  record_sessions: false
checkpoints:
  enabled: false
compression:
  enabled: true
  threshold: 0.5
  summary_model: google/gemini-3-flash-preview
  summary_provider: auto
display:
  compact: false
  personality: {{ (personality | default('professional')) | tojson }}
  resume_display: full
  bell_on_complete: false
  show_reasoning: false
  skin: default
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
timezone: {{ (timezone | default('America/New_York')) | tojson }}
{% if (discord_channel is defined and discord_channel) or (discord_guild_id is defined and discord_guild_id) or (a2a_discord_enabled is defined and a2a_discord_enabled and a2a_discord_channel_id is defined and a2a_discord_channel_id) %}
discord:
{% if discord_channel is defined and discord_channel %}
  require_mention: true
{% endif %}
{% if discord_guild_id is defined and discord_guild_id %}
  guild_id: {{ discord_guild_id | tojson }}
{% endif %}
{% if discord_free_response_channels is defined and discord_free_response_channels %}
  free_response_channel_ids: {{ discord_free_response_channels.split(',') | map('trim') | reject('equalto', '') | list | tojson }}
{% elif a2a_discord_enabled is defined and a2a_discord_enabled and a2a_discord_channel_id is defined and a2a_discord_channel_id %}
  free_response_channel_ids:
  - {{ a2a_discord_channel_id | tojson }}
{% endif %}
{% endif %}
security:
  redact_secrets: true
  tirith_enabled: true
runtime:
  envelope: {{ (runtime_envelope | default('hermes_alpha')) | tojson }}
  contract_version: {{ (runtime_contract_version | default('1')) | tojson }}
  hermes_home: {{ (hermes_home | default('/home/agent/.hermes')) | tojson }}
  gateway_service: {{ (runtime_gateway_service | default('hermes-gateway')) | tojson }}
  persistent_paths: {{ (runtime_persistent_paths | default('/home/agent/.hermes,/home/agent/.config/hermes,/home/agent/workspace')) | tojson }}
  sidecar_services: {{ (runtime_sidecar_services | default('')) | tojson }}
  health_command: {{ (runtime_health_command | default('systemctl is-active --quiet hermes-gateway && test -d /home/agent/.hermes')) | tojson }}
envoy:
  operator: Zay
  discord_handle: "@envoy"
  delegate_task_limit: {{ envoy_delegate_task_limit | default(3) }}
  paperclip_auth_mode: {{ (paperclip_operator_auth_mode | default('operator')) | tojson }}
  linear_argus_project: {{ (linear_argus_project_key | default('Argus')) | tojson }}
{% if a2a_discord_enabled is defined and a2a_discord_enabled %}
  a2a:
    discord_enabled: true
    channel_id: {{ (a2a_discord_channel_id | default('')) | tojson }}
    peer_name: {{ (a2a_discord_peer_name | default('argus')) | tojson }}
    peer_user_id: {{ (a2a_discord_peer_user_id | default('')) | tojson }}
    max_turns: {{ a2a_discord_max_turns | default(12) }}
    idle_seconds: {{ a2a_discord_idle_seconds | default(900) }}
{% endif %}
hud:
  enabled: {{ hud_enabled | default(true) | tojson }}
  sample_interval_seconds: {{ hud_sample_interval_seconds | default(60) }}
  ingest_url: {{ (hud_ingest_url | default('')) | tojson }}
_config_version: 1
