# {{ agent_name }} — 1Password secret references
{% for secret in secrets %}
{{ secret.env_var | env_key }}={{ secret.op_ref | env_value }}
{% endfor %}
FLEET_OPERATOR_MODE=1
FLEET_OPERATOR_WRITE_MODE={{ write_mode | default('proposal_only') }}
FLEET_OPERATOR_OUTPUT_FORMAT={{ cli_output_format | default('toon') }}
MONOLITH_FLEET_OUTPUT={{ cli_output_format | default('toon') }}+evidence
FLEET_API_URL={{ fleet_api_url | default(fleet_api_url_default) }}
MONOLITH_API_URL={{ monolith_api_url | default(fleet_api_url | default(fleet_api_url_default)) }}
